---
// Página de um episódio: mesma estrutura e classes de renderEpisodeDetail()
// no src/main.ts antigo (episodio.html?id=...), agora no HTML. Episódios só
// existem em português; o seletor de idioma leva a /en/podcast.
import Base from "../../../layouts/Base.astro";
import { t } from "../../../lib/i18n";
import { formatarData } from "../../../lib/noticias";
import { episodios, urlEpisodio, type Episodio } from "../../../lib/episodios";

export function getStaticPaths() {
  return episodios.map((episodio) => ({ params: { id: episodio.id }, props: { episodio } }));
}

const { episodio } = Astro.props as { episodio: Episodio };
const lang = "pt";
const outros = episodios.filter((e) => e.id !== episodio.id);
const pad = (n: number) => String(n).padStart(2, "0");
const meta = `${formatarData(episodio.date, lang)} · ${episodio.duration}`;
const transcricao = episodio.transcript ?? [];
---

<Base
  lang={lang}
  title={`${episodio.title} — Astrobotânica`}
  description={episodio.description || undefined}
  path={urlEpisodio(episodio.id)}
  temOutroIdioma={false}
  destinoSemTraducao="/podcast"
  secao="/podcast"
>
  <link slot="head" rel="alternate" type="application/rss+xml" title="Jardim em Expansão — Podcast Astrobotânica" href="/podcast.xml" />
  <article class="wrap" style="padding-top:2.5rem;padding-bottom:1.5rem">
    <a href="/podcast" class="btn btn-ghost" style="margin-bottom:1rem;display:inline-block">{t(lang, "episodio.backLink")}</a>
    <div id="episodio-content">
      {
        episodio.image ? (
          <div class="episode-cover">
            <img src={`/${episodio.image}`} alt="" />
            <div class="episode-cover-overlay">
              <span class="tag tag-accent">{t(lang, "episodio.tag", { number: episodio.number })}</span>
              <h1>{episodio.title}</h1>
              <p class="episode-detail-meta">{meta}</p>
            </div>
          </div>
        ) : (
          <>
            <span class="tag tag-accent">{t(lang, "episodio.tag", { number: episodio.number })}</span>
            <h1>{episodio.title}</h1>
            <p class="episode-detail-meta">{meta}</p>
          </>
        )
      }
      <div class="episode-content-col">
        <p class="player-label">{t(lang, "episodio.listenLabel")}</p>
        <div class="player-panel">
          <audio controls preload="none">
            <source src={`/${episodio.audioSrc}`} type="audio/mpeg" />
            {t(lang, "episodio.audioUnsupported")}
          </audio>
        </div>
        <div class="episode-description">
          <p>{episodio.description}</p>
        </div>
        {
          transcricao.length > 0 && (
            <>
              <h2 class="transcript-heading">{t(lang, "episodio.transcriptHeading")}</h2>
              {/* Aberta no HTML (legível sem JavaScript); o script recolhe e mostra o botão. */}
              <div class="transcript-wrap" data-transcricao>
                <div class="episode-body">
                  {transcricao.map((paragrafo) => <p>{paragrafo}</p>)}
                </div>
              </div>
              <button
                type="button"
                class="transcript-toggle"
                hidden
                data-expandir={t(lang, "episodio.transcriptExpand")}
                data-recolher={t(lang, "episodio.transcriptCollapse")}
              >
                <span class="chevron">▼</span> <span class="rotulo">{t(lang, "episodio.transcriptExpand")}</span>
              </button>
            </>
          )
        }
      </div>
    </div>
  </article>
  <section class="section wrap">
    <h2 style="font-size:1.4rem;margin-bottom:1.5rem">{t(lang, "episodio.relatedHeading")}</h2>
    <div id="episodio-related" style="display:flex;flex-direction:column;gap:0.875rem">
      {
        outros.length === 0 ? (
          <p class="empty-state">{t(lang, "episodio.noOthers")}</p>
        ) : (
          outros.map((e) => (
            <a class="episode-row" href={urlEpisodio(e.id)}>
              <span class="episode-row-number">{t(lang, "episodio.epNumber", { number: pad(e.number) })}</span>
              <div class="episode-row-main episode-row-title">{e.title}</div>
              <div class="episode-row-meta">{e.duration}</div>
            </a>
          ))
        )
      }
    </div>
  </section>
</Base>

<script>
  const wrap = document.querySelector<HTMLElement>("[data-transcricao]");
  const botao = document.querySelector<HTMLButtonElement>(".transcript-toggle");
  if (wrap && botao) {
    const chevron = botao.querySelector(".chevron")!;
    const rotulo = botao.querySelector(".rotulo")!;
    wrap.classList.add("collapsed");
    botao.hidden = false;
    botao.addEventListener("click", () => {
      const recolhida = wrap.classList.toggle("collapsed");
      chevron.textContent = recolhida ? "▼" : "▲";
      rotulo.textContent = (recolhida ? botao.dataset.expandir : botao.dataset.recolher) ?? "";
    });
  }
</script>
