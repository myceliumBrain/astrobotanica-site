---
// /estudos/: verbetes publicados agrupados por categoria, na ordem de
// data/categorias_estudo.json (renderEstudosIndex). A busca por título
// filtra no navegador; sem JS, a lista completa já está no HTML. Em EN, o
// verbete sem tradução aparece em português, com selo e link para a página PT.
import Base from "../../layouts/Base.astro";
import { t, type Lang } from "../../lib/i18n";
import { categoriasEstudo, nomeCategoria, verbeteNoIdioma, verbetesPublicados } from "../../lib/estudos";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const publicados = verbetesPublicados;
const grupos = categoriasEstudo
  .map((categoria) => ({
    nome: nomeCategoria(categoria, lang),
    itens: publicados.filter((v) => v.categoriaId === categoria.id).map((v) => ({ v, textos: verbeteNoIdioma(v, lang) })),
  }))
  .filter((g) => g.itens.length > 0);
---

<Base lang={lang} title={t(lang, "estudos.metaTitle")} description={t(lang, "estudos.metaDescription")} path="/estudos/">
  <section class="page-header wrap">
    <h1>{t(lang, "estudos.title")}</h1>
    <p>{t(lang, "estudos.intro")}</p>
  </section>

  <section class="section wrap">
    {
      publicados.length === 0 ? (
        <p class="empty-state">{t(lang, "estudos.emptyList")}</p>
      ) : (
        <>
          <div class="estudos-search-row" hidden>
            <input
              type="search"
              id="estudos-search"
              class="estudos-search-input"
              placeholder={t(lang, "estudos.searchPlaceholder")}
              aria-label={t(lang, "estudos.searchPlaceholder")}
            />
          </div>
          <div id="estudos-list">
            {grupos.map(({ nome, itens }) => (
              <section class="estudos-category">
                <h2 class="estudos-category-heading">{nome}</h2>
                <div class="article-grid">
                  {itens.map(({ v, textos }) => (
                    <a class="article-card" href={textos.href} data-titulo={textos.titulo.toLowerCase()}>
                      <div class="article-card-image">{v.imagemCapa && <img src={`/${v.imagemCapa}`} alt="" loading="lazy" />}</div>
                      <div class="article-card-kicker">{nome}</div>
                      <div class="article-card-title" lang={textos.soPortugues ? "pt" : undefined}>{textos.titulo}</div>
                      <div class="article-card-meta" lang={textos.soPortugues ? "pt" : undefined}>{textos.definicaoCurta}</div>
                      {textos.soPortugues && <span class="selo-so-portugues">{t(lang, "listas.soPortugues")}</span>}
                    </a>
                  ))}
                </div>
              </section>
            ))}
            <p class="empty-state" id="estudos-sem-resultado" hidden>
              {t(lang, "estudos.emptySearch")}
            </p>
          </div>
        </>
      )
    }
  </section>
</Base>

<script>
  const busca = document.querySelector<HTMLInputElement>("#estudos-search");
  if (busca) {
    busca.closest<HTMLElement>(".estudos-search-row")!.hidden = false;
    busca.addEventListener("input", () => {
      const q = busca.value.trim().toLowerCase();
      let algum = false;
      document.querySelectorAll<HTMLElement>(".estudos-category").forEach((secao) => {
        let visiveis = 0;
        secao.querySelectorAll<HTMLElement>("[data-titulo]").forEach((card) => {
          const mostra = !q || card.dataset.titulo!.includes(q);
          card.hidden = !mostra;
          if (mostra) visiveis++;
        });
        secao.hidden = visiveis === 0;
        if (visiveis) algum = true;
      });
      document.querySelector<HTMLElement>("#estudos-sem-resultado")!.hidden = algum;
    });
  }
</script>
