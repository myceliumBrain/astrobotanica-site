---
// Linha de episódio, como buildEpisodeRow: na lista do podcast (com
// descrição) e no painel da página inicial (sem).
import { t, type Lang } from "../lib/i18n";
import { formatarData } from "../lib/noticias";
import { episodioNoIdioma, type Episodio } from "../lib/episodios";
import { pad } from "../lib/listas";

interface Props {
  episodio: Episodio;
  lang: Lang;
  comDescricao?: boolean;
}

const { episodio: e, lang, comDescricao = false } = Astro.props;
// Em EN, episódio sem tradução: textos em português, com selo e link para a página PT.
const textos = episodioNoIdioma(e, lang);
const idioma = textos.soPortugues ? "pt" : undefined;
---

<a class="episode-row" href={textos.href}>
  {
    e.image && (
      <div class="episode-row-image">
        <img src={`/${e.image}`} alt="" loading="lazy" />
      </div>
    )
  }
  <span class="episode-row-number">{t(lang, "episodio.epNumber", { number: pad(e.number) })}</span>
  <div class="episode-row-main">
    <div class="episode-row-title" lang={idioma}>{textos.title}</div>
    {comDescricao && <p class="episode-row-desc" lang={idioma}>{textos.description}</p>}
    {textos.soPortugues && <span class="selo-so-portugues">{t(lang, "listas.soPortugues")}</span>}
  </div>
  <div class="episode-row-meta">
    <span>{formatarData(e.date, lang)}</span>
    <span>{e.duration}</span>
  </div>
</a>
