---
// Layout comum a todas as páginas: <head>, cabeçalho, menu (desktop e
// overlay do celular) e rodapé — mesma marcação e classes do HTML antigo,
// para o css/style.css funcionar sem alteração, mas com os textos já
// preenchidos no build (visíveis sem JavaScript).
import { linksDoIcone } from "../lib/icone";
import { idiomasDoSite } from "../lib/idiomas";
import { t, valor, caminhoNoIdioma, LANGS, type Lang } from "../lib/i18n";
import { itensDoMenu, menuDoCabecalho } from "../lib/menu";
import { NOME_SITE, OG_IMAGEM_PADRAO, jsonLdSeguro, organizacao } from "../lib/seo";

interface Props {
  lang: Lang;
  /** Único por página (scripts/migracao/verificar-seo.mjs confere). */
  title: string;
  /** Única por página. */
  description: string;
  /** Caminho da página sem o prefixo /en (ex.: "/sobre"). */
  path: string;
  /** false quando a página não tem tradução real no outro idioma: sem hreflang. */
  temOutroIdioma?: boolean;
  /** Para onde o seletor de idioma leva quando temOutroIdioma é false. */
  destinoSemTraducao?: string;
  /** false: noindex, sem canonical nem hreflang (ex.: 404). */
  indexavel?: boolean;
  /** Item do menu marcado como atual, quando não é o 1º segmento do caminho (ex.: episódios → "/podcast"). */
  secao?: string;
  /** Imagem do Open Graph (URL absoluta); sem ela, a imagem padrão do site. */
  imagem?: string;
  /** og:type: "website" ou "article". */
  ogTipo?: string;
  /** Nós JSON-LD da página, além da Organization (que vai em todas). */
  jsonLd?: Record<string, unknown>[];
}

const {
  lang,
  title,
  description,
  path,
  temOutroIdioma = true,
  destinoSemTraducao,
  indexavel = true,
  secao,
  imagem = OG_IMAGEM_PADRAO,
  ogTipo = "website",
  jsonLd = [],
} = Astro.props;
const outro: Lang = lang === "pt" ? "en" : "pt";
const site = Astro.site!;
const urlAqui = new URL(caminhoNoIdioma(path, lang), site).href;
const urlPt = new URL(caminhoNoIdioma(path, "pt"), site).href;
const urlEn = new URL(caminhoNoIdioma(path, "en"), site).href;
const hrefOutro = temOutroIdioma ? caminhoNoIdioma(path, outro) : caminhoNoIdioma(destinoSemTraducao ?? "/", outro);

const link = (p: string) => caminhoNoIdioma(p, lang);
const secaoAtual = secao ?? "/" + (path.split("/")[1] ?? "");

// Itens e ordem vêm do painel (data/site.json → menu, ver src/lib/menu.ts).
// Cabeçalho: links soltos e listas ("Conteúdo", "Institucional") que abrem
// ao clicar; os itens de destaque (Contato) vão para a direita, com borda.
const navItens = itensDoMenu(lang);
const { blocos, destaque } = menuDoCabecalho(lang);
const ehAtual = (item: { secao?: string }) => item.secao === secaoAtual;
// Seletor de idioma: bandeira escolhida no painel (ou o emoji de sempre).
const idiomas = idiomasDoSite().map((i) => ({
  ...i,
  href: i.lang === lang ? caminhoNoIdioma(path, lang) : hrefOutro,
  atual: i.lang === lang,
}));
// Menu do celular: os itens nos dois idiomas. As bandeiras de lá só trocam o
// idioma dos itens (sem sair da página nem fechar o menu).
const menusDoOverlay = LANGS.map((l) => ({ lang: l, hreflang: l === "pt" ? "pt-BR" : l, ...menuDoCabecalho(l) }));
// Rodapé: "Institucional" numa coluna própria; o resto em "Navegação".
const institucionais = navItens.filter((item) => item.grupo === "institucional");
const navRodape = navItens.filter((item) => item.grupo !== "institucional");

// Links cadastrados no painel às vezes vêm sem protocolo ("www.youtube.com"),
// o que viraria um link relativo quebrado.
const comProtocolo = (url: string) => (/^[a-z][a-z0-9+.-]*:/i.test(url) ? url : `https://${url}`);
// Rede social só aparece com o endereço do perfil preenchido: só o domínio
// ("www.youtube.com", que é o que fica enquanto ninguém preencheu) não conta.
const temPerfil = (url: string) => {
  try {
    const u = new URL(comProtocolo(url.trim()));
    return u.pathname.replace(/\/+$/, "") !== "" || u.search !== "";
  } catch {
    return false;
  }
};
const redes = (valor<{ label: string; url: string }[]>(lang, "socialLinks") ?? []).filter((r) => r.label?.trim() && r.url && temPerfil(r.url));

const licencaUrl =
  lang === "pt" ? "https://creativecommons.org/licenses/by/4.0/deed.pt-br" : "https://creativecommons.org/licenses/by/4.0/deed.en";
---

<!doctype html>
<html lang={lang === "en" ? "en" : "pt-BR"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexavel ? <link rel="canonical" href={urlAqui} /> : <meta name="robots" content="noindex" />}
    {
      indexavel && temOutroIdioma && (
        <>
          <link rel="alternate" hreflang="pt-BR" href={urlPt} />
          <link rel="alternate" hreflang="en" href={urlEn} />
          <link rel="alternate" hreflang="x-default" href={urlPt} />
        </>
      )
    }
    <link rel="preload" href="/fonts/barlow-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-condensed-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/css/style.css" />
    {linksDoIcone().map((l) => <link rel={l.rel} href={l.href} type={l.type} sizes={l.sizes} />)}
    <link rel="alternate" type="application/rss+xml" title={lang === "en" ? "Astrobotânica — News" : "Astrobotânica — Notícias"} href={link("/rss.xml")} />
    <meta property="og:type" content={ogTipo} />
    <meta property="og:site_name" content={NOME_SITE} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "pt_BR"} />
    {indexavel && temOutroIdioma && <meta property="og:locale:alternate" content={lang === "en" ? "pt_BR" : "en_US"} />}
    {indexavel && <meta property="og:url" content={urlAqui} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imagem} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagem} />
    <script type="application/ld+json" set:html={jsonLdSeguro([organizacao(), ...jsonLd])} />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-top">
        <a href={link("/")} class="brand-mark">{t(lang, "brand.name")}</a>
        <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-overlay">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="visually-hidden">{t(lang, "common.openMenu")}</span>
        </button>
      </div>
      <hr class="header-divider" />
      <nav class="wrap header-nav">
        {
          blocos.map((bloco) =>
            bloco.tipo === "link" ? (
              <a href={bloco.item.href} aria-current={ehAtual(bloco.item) ? "page" : undefined}>
                {bloco.item.texto}
              </a>
            ) : (
              <details class="nav-grupo">
                <summary class:list={["nav-grupo-titulo", { "is-atual": bloco.itens.some(ehAtual) }]}>{bloco.texto}</summary>
                <div class="nav-grupo-lista">
                  {bloco.itens.map((item) => (
                    <a href={item.href} aria-current={ehAtual(item) ? "page" : undefined}>
                      {item.texto}
                    </a>
                  ))}
                </div>
              </details>
            )
          )
        }
        <div class="header-nav-right">
          <slot name="nav-direita" />
          {destaque.map((item) => (
            <a class="nav-destaque" href={item.href} aria-current={ehAtual(item) ? "page" : undefined}>
              {item.texto}
            </a>
          ))}
          <div class="lang-switch" role="group" aria-label={t(lang, "common.language")}>
            {idiomas.map((i) => (
              <a class="lang-btn" href={i.href} hreflang={i.hreflang} lang={i.hreflang} aria-label={i.nome} title={i.nome} aria-current={i.atual ? "true" : undefined}>
                {i.bandeira ? <img class="lang-bandeira" src={i.bandeira} alt="" width="24" height="16" /> : i.emoji}
              </a>
            ))}
          </div>
        </div>
      </nav>
    </header>

    <!-- Menu do celular em camadas: a primeira tem só os grupos ("Conteúdo",
         "Institucional") e os links soltos (Publique conosco, Contato); tocar
         num grupo mostra os itens dele, com a seta ← para voltar. Ver
         setupNavOverlay em src/scripts/cliente.ts. -->
    <div class="nav-overlay" id="nav-overlay">
      <nav class="nav-overlay-panel">
        <button type="button" class="nav-overlay-voltar" aria-label={lang === "en" ? "Back" : "Voltar"} hidden>
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
        </button>
        <button type="button" class="nav-overlay-close" aria-label={t(lang, "common.closeMenu")}>✕</button>
        {
          menusDoOverlay.map((m) => (
            <div class="nav-overlay-idioma" data-idioma={m.lang} lang={m.hreflang} hidden={m.lang !== lang}>
              <div class="nav-camada" data-camada="principal">
                {m.blocos.map((bloco) =>
                  bloco.tipo === "link" ? (
                    <a href={bloco.item.href} aria-current={ehAtual(bloco.item) && m.lang === lang ? "page" : undefined}>
                      {bloco.item.texto}
                    </a>
                  ) : (
                    <button type="button" class="nav-camada-abrir" data-abre={bloco.grupo} aria-expanded="false">
                      {bloco.texto}
                    </button>
                  )
                )}
                {m.destaque.map((item) => (
                  <a href={item.href} aria-current={ehAtual(item) && m.lang === lang ? "page" : undefined}>
                    {item.texto}
                  </a>
                ))}
                <div class="lang-switch" role="group" aria-label={t(m.lang, "common.language")}>
                  {idiomas.map((i) => (
                    <button type="button" class="lang-btn" data-troca-idioma={i.lang} lang={i.hreflang} aria-label={i.nome} title={i.nome} aria-pressed={i.lang === m.lang ? "true" : "false"} aria-current={i.lang === m.lang ? "true" : undefined}>
                      {i.bandeira ? <img class="lang-bandeira" src={i.bandeira} alt="" width="24" height="16" /> : i.emoji}
                    </button>
                  ))}
                </div>
              </div>
              {m.blocos.map(
                (bloco) =>
                  bloco.tipo === "grupo" && (
                    <div class="nav-camada" data-camada={bloco.grupo} aria-label={bloco.texto} hidden>
                      {bloco.itens.map((item) => (
                        <a href={item.href} aria-current={ehAtual(item) && m.lang === lang ? "page" : undefined}>
                          {item.texto}
                        </a>
                      ))}
                    </div>
                  )
              )}
            </div>
          ))
        }
      </nav>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <span class="footer-word">{t(lang, "brand.name")}</span>
          <p class="footer-tagline">{t(lang, "brand.footerTagline")}</p>
        </div>
        <div class="footer-cols">
          <div class="footer-col">
            <span class="footer-heading">{t(lang, "footer.navHeading")}</span>
            {navRodape.map((item) => <a href={item.href}>{item.texto}</a>)}
          </div>
          {
            institucionais.length > 0 && (
              <div class="footer-col">
                <span class="footer-heading">{t(lang, "footer.institutionalHeading")}</span>
                {institucionais.map((item) => <a href={item.href}>{item.texto}</a>)}
              </div>
            )
          }
          {
            redes.length > 0 && (
              <div class="footer-col">
                <span class="footer-heading">{t(lang, "footer.socialHeading")}</span>
                {redes.map((r) => (
                  <a href={comProtocolo(r.url)} target="_blank" rel="noopener noreferrer">
                    {r.label}
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </div>
      <div class="wrap footer-copy">
        {t(lang, "brand.copyright")}
        <span class="footer-license">
          {t(lang, "footer.licensePrefix")} <a href={licencaUrl} rel="license noopener" target="_blank">CC BY 4.0</a>.
        </span>
      </div>
    </footer>

    <script src="../scripts/cliente.ts"></script>
  </body>
</html>

<style is:global>
  /* O seletor de idioma agora é feito de links (antes, <button>): tira o
     sublinhado e mantém a mesma caixa dos botões de css/style.css. */
  .lang-btn {
    display: inline-block;
    text-decoration: none;
  }
  .footer-license {
    margin-left: 0.5em;
  }
  .footer-license a {
    color: inherit;
  }
</style>
